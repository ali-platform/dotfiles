#!/bin/env bash
# This script is designed to sourced from your shell to set the AWS_PROFILE variable

# Get current git branch
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# Initialize variables
STACK=""
export AWS_PROFILE=""

# Read the AWS account name out of a Pulumi stack config file. Every project
# namespaces its own config, so search each mapping for an accountName key.
stack_account_name() {
    local file="Pulumi.$1.yaml"
    [[ -f $file ]] || return
    yq e '[.config.[] | select(tag == "!!map") | select(has("accountName")) | .accountName] | .[0] // ""' "$file" 2>/dev/null
}

# Resolve a key (stack name or account name) against the Pulumi.*.yaml files in
# the current directory, setting STACK and AWS_PROFILE. Returns non-zero when no
# account could be determined.
resolve_stack() {
    local key=$1 file candidate account

    [ -n "$key" ] || return 1

    if [ -f "Pulumi.$key.yaml" ]; then
        STACK="$key"
        account=$(stack_account_name "$key")
        if [ -n "$account" ]; then
            AWS_PROFILE="$account"
            return 0
        fi
    fi

    for file in Pulumi.*.yaml; do
        [[ -f $file ]] || continue
        candidate=${file#Pulumi.}
        candidate=${candidate%.yaml}
        account=$(stack_account_name "$candidate")
        if [ -n "$account" ] && [ "$account" = "$key" ]; then
            STACK="$candidate"
            AWS_PROFILE="$account"
            return 0
        fi
    done

    return 1
}

if [ $# -gt 0 ]; then
    # Argument provided - treat it as a stack name, an account name, or a raw profile
    resolve_stack "$1" || AWS_PROFILE="$1"
else
    # No argument - resolve from the branch, then the selected Pulumi stack
    resolve_stack "$BRANCH_NAME" || resolve_stack "$(pulumi-current-stack 2>/dev/null | awk -F/ '{print $NF}')"
fi

if [ -z "$AWS_PROFILE" ]; then
    AWS_PROFILE="ali-shared"
fi

# This script is sourced, so keep the helpers out of the caller's shell
unset -f stack_account_name resolve_stack

# Verify that AWS_PROFILE exists in ~/.aws/config
if ! grep -q "\[profile $AWS_PROFILE\]" ~/.aws/config; then
  echo -e "\033[0;31mAWS_PROFILE $AWS_PROFILE not found in ~/.aws/config\033[0m"
  return 1
fi

echo -e "\033[0;36mUsing AWS account $AWS_PROFILE\033[0m"
MIN_LEFT=60

# Pick date command (gdate on macOS with coreutils)
DATEBIN="date"
if command -v gdate >/dev/null 2>&1; then DATEBIN="gdate"; fi

EXP_JSON="$(aws configure export-credentials --profile "$AWS_PROFILE" --format process 2>/dev/null || true)"
EXP_ISO="$(printf '%s' "$EXP_JSON" | jq -r '.Expiration // empty')"

REMAIN_SECS=-1
if [ -n "$EXP_ISO" ]; then
    EXP_EPOCH="$("$DATEBIN" -u -d "$EXP_ISO" +%s 2>/dev/null || true)"
    if [ -n "$EXP_EPOCH" ]; then
        NOW_EPOCH="$("$DATEBIN" -u +%s)"
        REMAIN_SECS=$(( EXP_EPOCH - NOW_EPOCH ))
    fi
fi

REQUIRED_SECS=$(( MIN_LEFT * 60 ))
NEED_LOGIN=0

# Expiration-only check
if (( REMAIN_SECS < 0 )) || (( REMAIN_SECS < REQUIRED_SECS )); then
    NEED_LOGIN=1
fi

if (( NEED_LOGIN == 0 )); then
    REMAIN_MIN=$(( REMAIN_SECS / 60 ))
    echo "OK: ${REMAIN_MIN} minutes left (expires at ${EXP_ISO})."
else
    if (( REMAIN_SECS > 0 )); then
        REMAIN_MIN=$(( REMAIN_SECS / 60 ))
        echo "NOT OK: only ${REMAIN_MIN} minutes left (expires at ${EXP_ISO})." >&2
    else
        echo "NOT OK: credentials missing/expired/invalid (expires at ${EXP_ISO:-unknown})." >&2
    fi
    echo -e "\033[0;36mAuthenticating with SSO\033[0m"
    aws sso login --profile "$AWS_PROFILE"
fi

CLUSTER=$(aws eks list-clusters --query clusters[0] --output text)
if [[ "$CLUSTER" != "None" ]]
then
    echo -e "\033[0;36mAuthenticating to the $CLUSTER kubernetes cluster\033[0m"
    aws eks update-kubeconfig --region us-east-2 --name $CLUSTER --alias $CLUSTER
fi

# Select Pulumi stack if a stack-specific config file exists
if [ -z "$STACK" ]; then
    STACK=$AWS_PROFILE
fi

if [ -f "Pulumi.$STACK.yaml" ]; then
    echo -e "\033[0;36mSelecting the $STACK pulumi stack\033[0m"
    pulumi stack select $STACK
fi
